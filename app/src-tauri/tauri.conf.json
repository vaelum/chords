{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chords",
  "version": "2026.6.3",
  "identifier": "app.chords.client",
  "build": {
    "frontendDist": "../../server/frontend",
    "beforeDevCommand": "node ../server/scripts/build-frontend.js",
    "beforeBuildCommand": "node ../server/scripts/build-frontend.js"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "chords",
        "width": 1080,
        "height": 760,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "guitar tabs that follow you",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
